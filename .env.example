# ==============================================================================
# NEXUS PRODUCTION & LOCAL ENVIRONMENT VARIABLES
# Copy this file to .env and configure appropriate values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND (Configured in Netlify / Cloud Host Environment Variables)
# ------------------------------------------------------------------------------
# Base URL of the live Nexus FastAPI backend (e.g. https://nexus-api.onrender.com)
# When not set locally, the frontend defaults to http://localhost:8000
VITE_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# BACKEND & SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# Port for Uvicorn server (automatically assigned by cloud providers like Render/Railway/Fly.io)
PORT=8000

# Allowed Frontend URL for CORS and OAuth redirects (e.g. https://nexus-docs.netlify.app)
FRONTEND_URL=http://localhost:5174

# High-entropy secret key for signing session JWT tokens
JWT_SECRET_KEY=replace-with-a-secure-random-64-character-hex-string

# ------------------------------------------------------------------------------
# GITHUB OAUTH (Configured in GitHub Developer Settings -> OAuth Apps)
# ------------------------------------------------------------------------------
# Client ID from your GitHub OAuth Application
GITHUB_CLIENT_ID=your-github-client-id

# Client Secret from your GitHub OAuth Application
GITHUB_CLIENT_SECRET=your-github-client-secret

# OAuth Callback URL matching GitHub Developer Settings
# Local: http://localhost:8000/auth/github/callback
# Production: https://<YOUR-BACKEND-DOMAIN>/auth/github/callback
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Leave empty for local SQLite (falls back to data/dev.db)
# For Production PostgreSQL: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=
